generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  VENDOR
  DRIVER
  CUSTOMER
  CORPORATE_ADMIN
  CORPORATE_EMPLOYEE
}

model User {
  id String @id @default(cuid())

  name   String
  email  String  @unique
  mobile String? @unique

  password String

  role UserRole @default(CUSTOMER)

  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  customer          Customer?
  vendor            Vendor?
  driver            Driver?
  corporateEmployee CorporateEmployee?

  notifications Notification[]

  auditLogs AuditLog[]

  loginHistory LoginHistory[]

  securityEvents SecurityEvent[]

  assignedLeads Lead[] @relation("LeadOwner")

  crmActivities CRMActivity[] @relation("ActivityOwner")

  crmTasks CRMTask[] @relation("TaskOwner")

  assignedTickets SupportTicket[] @relation("AssignedSupportAgent")

  ticketMessages TicketMessage[] @relation("SupportMessageSender")

  apiKeys APIKey[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  bookings Booking[]

  reviews Review[]

  loyaltyAccount LoyaltyAccount?

  referralPrograms ReferralProgram[]

  couponUsages CouponUsage[]

  analytics BookingAnalytics[]

  recommendations AIRecommendation[]

  supportTickets SupportTicket[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String

  isApproved Boolean @default(false)

  vehicles Vehicle[]

  bookings Booking[]

  documents VendorDocument[]

  pricingRules PricingRule[]

  transactions Transaction[]

  wallet VendorWallet?

  settlements VendorSettlement[]

  reviews Review[]

  promotions VendorPromotion[]

  performanceReports VendorPerformance[]

  revenueReports RevenueSummary[]

  analytics VendorAnalytics[]

  supportTickets SupportTicket[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  licenseNumber String @unique

  vehicles           Vehicle[]
  bookings           Booking[]
  trips              Trip[]
  documents          DriverDocument[]
  reviews            Review[]
  performanceReports DriverPerformance[]
  analytics          DriverAnalytics[]
  attendance         DriverAttendance[]

  shifts DriverShift[]

  leaveRequests DriverLeave[]

  payrolls DriverPayroll[]

  incentives DriverIncentive[]

  penalties DriverPenalty[]

  tripLocations TripLocation[]

  sosEvents SOSEvent[]

  supportTickets SupportTicket[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([licenseNumber])
  @@index([createdAt])
  @@index([firstName, lastName])
}

