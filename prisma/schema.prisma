model PricingRule {
  id String @id @default(cuid())

  vendorId String

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  vehicleCategory VehicleCategory

  pricingType PricingType

  tripType TripType

  chargeType ChargeType

  baseFare Decimal @db.Decimal(10, 2)

  minimumKm Int?

  includedKm Int?

  pricePerKm Decimal? @db.Decimal(10, 2)

  pricePerHour Decimal? @db.Decimal(10, 2)

  driverAllowance Decimal? @db.Decimal(10, 2)

  nightCharge Decimal? @db.Decimal(10, 2)

  waitingCharge Decimal? @db.Decimal(10, 2)

  isActive Boolean @default(true)

  dynamicPricingRules DynamicPricingRule[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([vendorId, vehicleCategory, pricingType, tripType])
  @@index([vendorId])
  @@index([vehicleCategory])
  @@index([pricingType])
  @@index([tripType])
  @@index([isActive])
  @@index([vendorId, isActive])
  @@index([vehicleCategory, pricingType])
}

model Transaction {
  id String @id @default(cuid())

  bookingId String?

  vendorId String?

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  transactionType TransactionType

  paymentMethod PaymentMethod

  paymentStatus PaymentStatus @default(PENDING)

  amount Decimal @db.Decimal(10, 2)

  currency String @default("INR")

  referenceNumber String?

  gatewayName String?

  gatewayTransactionId String?

  gatewayFee Decimal? @db.Decimal(10, 2)

  taxAmount Decimal? @db.Decimal(10, 2)

  gatewayResponse Json?

  remarks String?

  processedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([vendorId])
  @@index([paymentStatus])
  @@index([transactionType])
  @@index([paymentMethod])
  @@index([processedAt])
  @@index([createdAt])
  @@index([vendorId, paymentStatus])
  @@index([bookingId, paymentStatus])
}

model VendorWallet {
  id String @id @default(cuid())

  vendorId String @unique

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  balance Decimal @default(0) @db.Decimal(12, 2)

  transactions WalletTransaction[]

  settlements VendorSettlement[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

model WalletTransaction {
  id String @id @default(cuid())

  walletId String

  wallet VendorWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  transactionType WalletTransactionType

  amount Decimal @db.Decimal(12, 2)

  balanceBefore Decimal? @db.Decimal(12, 2)

  balanceAfter Decimal? @db.Decimal(12, 2)

  referenceId String?

  referenceType String?

  performedBy String?

  description String?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([referenceId])
  @@index([walletId, createdAt])
}

model VendorSettlement {
  id String @id @default(cuid())

  vendorId String

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  walletId String

  wallet VendorWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  commission Decimal @default(0) @db.Decimal(12, 2)

  netAmount Decimal @db.Decimal(12, 2)

  settlementStatus SettlementStatus @default(PENDING)

  settlementReference String?

  bankReference String?

  processedBy String?

  failureReason String?

  remarks String?

  settledAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([walletId])
  @@index([settlementStatus])
  @@index([createdAt])
  @@index([settledAt])
  @@index([vendorId, settlementStatus])
}

model Notification {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationType NotificationType

  title String

  message String

  status NotificationStatus @default(PENDING)

  sentAt DateTime?

  readAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
