  model Vehicle {
    id String @id @default(cuid())

    vendorId String

    driverId String?

    vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

    driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

    registrationNumber String @unique

    make String

    model String

    variant String?

    year Int?

    color String?

    category VehicleCategory

    fuelType FuelType

    transmission TransmissionType

    seatingCapacity Int

    luggageCapacity Int?

    homeCity String

    status VehicleStatus @default(AVAILABLE)

    baseFare Decimal @db.Decimal(10, 2)

    pricePerKm Decimal? @db.Decimal(10, 2)

    waitingCharge Decimal? @db.Decimal(10, 2)

    nightCharge Decimal? @db.Decimal(10, 2)

    rating Float @default(0)

    totalTrips Int @default(0)

    isVerified Boolean @default(false)

    bookings           Booking[]
    trips              Trip[]
    documents          VehicleDocument[]
    reviews            Review[]
    performanceReports VehiclePerformance[]
    analytics          VehicleAnalytics[]

    maintenanceRecords VehicleMaintenance[]

    fuelLogs FuelLog[]

    serviceSchedules ServiceSchedule[]

    breakdowns VehicleBreakdown[]

    dometerLogs OdometerLog[]

    gpsDevice GPSDevice?

    tripLocations TripLocation[]

    routeDeviations RouteDeviation[]

    sosEvents SOSEvent[]

    deletedAt DateTime?

    createdAt DateTime @default(now())

    updatedAt      DateTime        @updatedAt
    geofenceEvents GeofenceEvent[]

    @@index([vendorId])
    @@index([driverId])
    @@index([status])
    @@index([category])
    @@index([homeCity])
    @@index([isVerified])
    @@index([createdAt])
    @@index([vendorId, status])
    @@index([category, status])
    @@index([homeCity, category])
  }

