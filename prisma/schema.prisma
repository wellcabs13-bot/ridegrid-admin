model Booking {
  id String @id @default(cuid())

  bookingNumber String @unique @default(uuid())

  customerId String
  vendorId   String
  vehicleId  String
  driverId   String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver   Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  pickupLocation String
  dropLocation   String

  pickupDateTime DateTime

  status BookingStatus @default(PENDING)

  estimatedFare Decimal @db.Decimal(10, 2)

  baseFare       Decimal? @db.Decimal(10, 2)
  taxAmount      Decimal? @db.Decimal(10, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  couponAmount   Decimal? @db.Decimal(10, 2)
  extraCharges   Decimal? @db.Decimal(10, 2)
  finalFare      Decimal? @db.Decimal(10, 2)

  vendorEarning      Decimal? @db.Decimal(10, 2)
  platformCommission Decimal? @db.Decimal(10, 2)
  driverPayout       Decimal? @db.Decimal(10, 2)

  cancelledBy        String?
  cancelReason       String?
  cancelledAt        DateTime?
  cancellationCharge Decimal?  @db.Decimal(10, 2)
  refundAmount       Decimal?  @db.Decimal(10, 2)

  trip Trip?

  transactions Transaction[]

  reviews Review[]

  couponUsages CouponUsage[]

  analytics BookingAnalytics[]

  fraudChecks FraudDetection[]

  statusHistory BookingStatusHistory[]

  supportTickets SupportTicket[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([vendorId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  @@index([pickupDateTime])
  @@index([createdAt])
  @@index([customerId, status])
  @@index([vendorId, status])
  @@index([driverId, status])
  @@index([pickupDateTime, status])
  @@index([customerId, pickupDateTime])
  @@index([vendorId, pickupDateTime])
}

model BookingStatusHistory {
  id String @id @default(cuid())

  bookingId String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  previousStatus BookingStatus?

  currentStatus BookingStatus

  action BookingStatusAction

  changedBy String?

  remarks String?

  changedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([currentStatus])
  @@index([changedAt])
}

model Trip {
  id String @id @default(cuid())

  bookingId String @unique

  driverId String

  vehicleId String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  status TripStatus @default(ASSIGNED)

  driverAssignedAt DateTime?

  driverAcceptedAt DateTime?

  arrivedPickupAt DateTime?

  passengerBoardedAt DateTime?

  tripStartedAt DateTime?

  tripCompletedAt DateTime?

  cancelledAt DateTime?

  startTime DateTime?

  endTime DateTime?

  startKm Int?

  endKm Int?

  totalDistance Decimal? @db.Decimal(10, 2)

  totalDuration Int?

  rentalExtensions RentalExtension[]

  extraCharges ExtraCharge[]

  damageReports DamageReport[]

  tripExpenses TripExpense[]

  routeDeviations RouteDeviation[]

  returnApprovals ReturnApproval[]

  tripLocations TripLocation[]

  tripCheckpoints TripCheckpoint[]

  etaPredictions ETAPrediction[]

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt      DateTime        @updatedAt
  geofenceEvents GeofenceEvent[]
  sosevents      SOSEvent[]
}

model VehicleDocument {
  id String @id @default(cuid())

  vehicleId String

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  documentType DocumentType

  documentNumber String?

  fileUrl String

  issueDate DateTime?

  expiryDate DateTime?

  status DocumentStatus @default(PENDING)

  remarks String?

  verifiedBy String?

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model DriverDocument {
  id String @id @default(cuid())

  driverId String

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  documentType DocumentType

  documentNumber String?

  fileUrl String

  issueDate DateTime?

  expiryDate DateTime?

  status DocumentStatus @default(PENDING)

  remarks String?

  verifiedBy String?

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model VendorDocument {
  id String @id @default(cuid())

  vendorId String

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  documentType DocumentType

  documentNumber String?

  fileUrl String

  issueDate DateTime?

  expiryDate DateTime?

  status DocumentStatus @default(PENDING)

  remarks String?

  verifiedBy String?

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
