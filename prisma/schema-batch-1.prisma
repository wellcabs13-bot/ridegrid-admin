// =========================================
// RIDEGRID DATABASE
// BATCH 1
// Core Foundation
// =========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  VENDOR
  DRIVER
  CUSTOMER
  CORPORATE_ADMIN
  CORPORATE_EMPLOYEE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DriverStatus {
  PENDING
  ACTIVE
  ON_TRIP
  RETURNING
  OFF_DUTY
  LEAVE
  SUSPENDED
}

enum VehicleStatus {
  PENDING
  AVAILABLE
  ON_TRIP
  RETURNING
  MAINTENANCE
  SUSPENDED
}

model User {
  id            String   @id @default(cuid())

  name          String
  email         String   @unique
  mobile        String?  @unique
  password      String

  role          UserRole @default(CUSTOMER)

  isActive      Boolean  @default(true)
  isVerified    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}// =========================================
// RIDEGRID DATABASE
// BATCH 2
// Vendor Model
// =========================================

model Vendor {
  id                     String                 @id @default(cuid())

  userId                 String                 @unique

  businessName           String
  ownerName              String

  email                  String                 @unique
  mobile                 String                 @unique

  homeCity               String
  homeState              String
  address                String?

  gstNumber              String?
  panNumber              String?
  udyamNumber            String?

  securityDeposit        Decimal                @default(0)

  verificationStatus     VerificationStatus     @default(PENDING)
  status                 VendorStatus           @default(PENDING)

  commissionPercentage   Float                  @default(12)

  rating                 Float                  @default(0)
  totalTrips             Int                    @default(0)
  completedTrips         Int                    @default(0)
  cancelledTrips         Int                    @default(0)

  joinedAt               DateTime               @default(now())

  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicles               Vehicle[]
  drivers                Driver[]
  bookings               Booking[]
  settlements            Settlement[]
  wallet                 Wallet?

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([businessName])
  @@index([status])
  @@index([verificationStatus])
  @@index([homeCity])
}// =========================================
// RIDEGRID DATABASE
// BATCH 3
// Driver Model
// =========================================

model Driver {
  id                     String                 @id @default(cuid())

  userId                 String                 @unique
  vendorId               String

  fullName               String
  mobile                 String                 @unique
  email                  String?

  licenseNumber          String                 @unique
  aadhaarNumber          String?                @unique

  dateOfBirth            DateTime?
  joiningDate            DateTime?

  experienceYears        Int                    @default(0)

  emergencyContactName   String?
  emergencyContactMobile String?

  trustScore             Float                  @default(5)
  rating                 Float                  @default(0)

  totalTrips             Int                    @default(0)
  completedTrips         Int                    @default(0)
  cancelledTrips         Int                    @default(0)

  verificationStatus     VerificationStatus     @default(PENDING)
  status                 DriverStatus           @default(PENDING)

  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor                 Vendor                 @relation(fields: [vendorId], references: [id])

  vehicle                Vehicle?

  reviews                Review[]

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([verificationStatus])
  @@index([mobile])
  @@index([licenseNumber])
}// =========================================
// RIDEGRID DATABASE
// BATCH 4
// Customer Model
// =========================================

model Customer {
  id                    String      @id @default(cuid())

  userId                String      @unique

  fullName              String
  mobile                String      @unique
  email                 String?

  customerType          String      @default("RETAIL") // RETAIL | CORPORATE

  gender                String?

  dateOfBirth           DateTime?

  profilePhoto          String?

  emergencyName         String?
  emergencyMobile       String?

  defaultPickupAddress  String?
  defaultDropAddress    String?

  loyaltyPoints         Int         @default(0)

  totalBookings         Int         @default(0)
  completedTrips        Int         @default(0)
  cancelledTrips        Int         @default(0)

  totalSpent            Decimal     @default(0)

  rating                Float       @default(5)

  isCorporate           Boolean     @default(false)
  isBlocked             Boolean     @default(false)

  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookings              Booking[]
  reviews               Review[]
  wallet                Wallet?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([mobile])
  @@index([customerType])
  @@index([isCorporate])
  @@index([isBlocked])
}// =========================================
// RIDEGRID DATABASE
// BATCH 5
// Vehicle Model
// =========================================

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum VehicleCategory {
  HATCHBACK
  SEDAN
  PREMIUM_SEDAN
  SUV
  PREMIUM_SUV
  LUXURY
  MUV
  TEMPO_TRAVELLER
  MINI_BUS
  BUS
}

model Vehicle {
  id                     String             @id @default(cuid())

  vendorId               String
  driverId               String?            @unique

  registrationNumber     String             @unique

  brand                  String
  model                  String
  variant                String?

  manufacturingYear      Int

  color                  String?

  category               VehicleCategory

  fuelType               FuelType

  transmission           TransmissionType

  seatingCapacity        Int

  luggageCapacity        Int?

  baseFare               Decimal            @default(0)

  minimumFare            Decimal            @default(0)

  extraKmRate            Decimal            @default(0)

  waitingCharge          Decimal            @default(0)

  nightCharge            Decimal            @default(0)

  driverAllowance        Decimal            @default(0)

  status                 VehicleStatus      @default(PENDING)

  verificationStatus     VerificationStatus @default(PENDING)

  rating                 Float              @default(0)

  totalTrips             Int                @default(0)

  completedTrips         Int                @default(0)

  cancelledTrips         Int                @default(0)

  homeCity               String

  vendor                 Vendor             @relation(fields: [vendorId], references: [id])

  driver                 Driver?            @relation(fields: [driverId], references: [id])

  bookings               Booking[]

  trips                  Trip[]

  createdAt              DateTime           @default(now())

  updatedAt              DateTime           @updatedAt

  @@index([vendorId])
  @@index([driverId])
  @@index([registrationNumber])
  @@index([status])
  @@index([category])
  @@index([homeCity])
}// =========================================
// RIDEGRID DATABASE
// BATCH 6
// Vehicle Documents + Driver Documents + Vendor Documents
// =========================================

enum DocumentType {
  RC
  INSURANCE
  FITNESS
  POLLUTION
  PERMIT
  TAX
  DRIVING_LICENSE
  AADHAAR
  PAN
  POLICE_VERIFICATION
  GST
  UDYAM
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model VehicleDocument {
  id                String            @id @default(cuid())

  vehicleId         String

  documentType      DocumentType

  documentNumber    String?

  fileUrl           String

  issueDate         DateTime?

  expiryDate        DateTime?

  status            DocumentStatus    @default(PENDING)

  verifiedBy        String?

  verifiedAt        DateTime?

  remarks           String?

  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([vehicleId])
  @@index([documentType])
  @@index([status])
}

model DriverDocument {
  id                String            @id @default(cuid())

  driverId          String

  documentType      DocumentType

  documentNumber    String?

  fileUrl           String

  issueDate         DateTime?

  expiryDate        DateTime?

  status            DocumentStatus    @default(PENDING)

  verifiedBy        String?

  verifiedAt        DateTime?

  remarks           String?

  driver            Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([driverId])
  @@index([documentType])
  @@index([status])
}

model VendorDocument {
  id                String            @id @default(cuid())

  vendorId          String

  documentType      DocumentType

  documentNumber    String?

  fileUrl           String

  issueDate         DateTime?

  expiryDate        DateTime?

  status            DocumentStatus    @default(PENDING)

  verifiedBy        String?

  verifiedAt        DateTime?

  remarks           String?

  vendor            Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([vendorId])
  @@index([documentType])
  @@index([status])
}// =========================================
// RIDEGRID DATABASE
// BATCH 7
// Booking Model (Core Marketplace)
// =========================================

enum BookingType {
  LOCAL
  AIRPORT
  ONEWAY
  ROUNDTRIP
  MULTICITY
  HOURLY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  VENDOR_ACCEPTED
  DRIVER_ASSIGNED
  DRIVER_ENROUTE
  ARRIVED
  OTP_VERIFIED
  TRIP_STARTED
  TRIP_COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

model Booking {
  id                    String          @id @default(cuid())

  bookingNumber         String          @unique

  customerId            String
  vendorId              String
  vehicleId             String
  driverId              String

  bookingType           BookingType

  pickupCity            String
  dropCity              String

  pickupAddress         String
  dropAddress           String

  pickupDate            DateTime

  estimatedDistance     Float?

  estimatedDuration     Int?

  passengers            Int             @default(1)

  baseFare              Decimal         @default(0)

  extraCharges          Decimal         @default(0)

  discount              Decimal         @default(0)

  taxAmount             Decimal         @default(0)

  totalAmount           Decimal

  advanceAmount         Decimal         @default(0)

  dueAmount             Decimal         @default(0)

  paymentStatus         PaymentStatus   @default(PENDING)

  status                BookingStatus   @default(PENDING)

  customerRemarks       String?

  vendorRemarks         String?

  adminRemarks          String?

  customer              Customer        @relation(fields: [customerId], references: [id])

  vendor                Vendor          @relation(fields: [vendorId], references: [id])

  vehicle               Vehicle         @relation(fields: [vehicleId], references: [id])

  driver                Driver          @relation(fields: [driverId], references: [id])

  trip                  Trip?

  review                Review?

  createdAt             DateTime        @default(now())

  updatedAt             DateTime        @updatedAt

  @@index([bookingNumber])
  @@index([customerId])
  @@index([vendorId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([pickupDate])
  @@index([status])
  @@index([paymentStatus])
}// =========================================
// RIDEGRID DATABASE
// BATCH 8
// Trip + Smart Return + Live Tracking
// =========================================

enum TripStatus {
  SCHEDULED
  DRIVER_STARTED
  DRIVER_REACHED
  OTP_VERIFIED
  STARTED
  ONGOING
  COMPLETED
  CANCELLED
}

enum SmartReturnStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  LISTED
  BOOKED
  EXPIRED
}

model Trip {
  id                     String              @id @default(cuid())

  bookingId              String              @unique

  startOtp               String?

  endOtp                 String?

  actualStartTime        DateTime?

  actualEndTime          DateTime?

  actualDistance         Float?

  actualDuration         Int?

  startLatitude          Float?
  startLongitude         Float?

  endLatitude            Float?
  endLongitude           Float?

  currentLatitude        Float?
  currentLongitude       Float?

  driverStartedAt        DateTime?
  driverReachedAt        DateTime?

  tripStatus             TripStatus          @default(SCHEDULED)

  smartReturnStatus      SmartReturnStatus   @default(NOT_ELIGIBLE)

  booking                Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  smartReturn            SmartReturn?

  trackingLogs           TripTracking[]

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([tripStatus])
  @@index([smartReturnStatus])
}

model SmartReturn {
  id                     String               @id @default(cuid())

  tripId                 String               @unique

  vehicleId              String

  vendorId               String

  fromCity               String

  toHomeCity             String

  availableAfter         DateTime

  expiresAt              DateTime

  suggestedFare          Decimal

  status                 SmartReturnStatus    @default(ELIGIBLE)

  trip                   Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)

  vehicle                Vehicle              @relation(fields: [vehicleId], references: [id])

  vendor                 Vendor               @relation(fields: [vendorId], references: [id])

  createdAt              DateTime             @default(now())

  @@index([vehicleId])
  @@index([vendorId])
  @@index([status])
  @@index([fromCity])
  @@index([toHomeCity])
}

model TripTracking {
  id                     String      @id @default(cuid())

  tripId                 String

  latitude               Float

  longitude              Float

  speed                  Float?

  heading                Float?

  accuracy               Float?

  recordedAt             DateTime    @default(now())

  trip                   Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([recordedAt])
}// =========================================
// RIDEGRID DATABASE
// BATCH 9
// Wallet + Payment + Transaction Engine
// =========================================

enum WalletType {
  CUSTOMER
  VENDOR
  RIDEGRID
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND
  PENALTY
  COMMISSION
  SETTLEMENT
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NETBANKING
  WALLET
  CORPORATE_CREDIT
}

enum PaymentGatewayStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

model Wallet {
  id                  String        @id @default(cuid())

  customerId          String?       @unique
  vendorId            String?       @unique

  walletType          WalletType

  balance             Decimal       @default(0)

  holdBalance         Decimal       @default(0)

  totalCredit         Decimal       @default(0)

  totalDebit          Decimal       @default(0)

  customer            Customer?     @relation(fields: [customerId], references: [id])

  vendor              Vendor?       @relation(fields: [vendorId], references: [id])

  transactions        WalletTransaction[]

  createdAt           DateTime      @default(now())

  updatedAt           DateTime      @updatedAt
}

model WalletTransaction {
  id                  String                 @id @default(cuid())

  walletId            String

  bookingId           String?

  type                WalletTransactionType

  amount              Decimal

  balanceAfter        Decimal

  description         String?

  wallet              Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  booking             Booking?              @relation(fields: [bookingId], references: [id])

  createdAt           DateTime              @default(now())

  @@index([walletId])
  @@index([bookingId])
}

model Payment {
  id                  String                  @id @default(cuid())

  bookingId           String                  @unique

  paymentMethod       PaymentMethod

  gatewayStatus       PaymentGatewayStatus    @default(INITIATED)

  gatewayTransactionId String?

  orderId             String?

  paidAmount          Decimal

  refundAmount        Decimal                 @default(0)

  paymentTime         DateTime?

  booking             Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt           DateTime                @default(now())

  updatedAt           DateTime                @updatedAt

  @@index([gatewayStatus])
}

model Settlement {
  id                  String      @id @default(cuid())

  vendorId            String

  bookingId           String       @unique

  grossAmount         Decimal

  commissionAmount    Decimal

  penaltyAmount       Decimal       @default(0)

  payableAmount       Decimal

  isInstantSettlement Boolean       @default(false)

  settled             Boolean       @default(false)

  settledAt           DateTime?

  vendor              Vendor        @relation(fields: [vendorId], references: [id])

  booking             Booking       @relation(fields: [bookingId], references: [id])

  createdAt           DateTime      @default(now())

  updatedAt           DateTime      @updatedAt

  @@index([vendorId])
  @@index([settled])
}// =========================================
// RIDEGRID DATABASE
// BATCH 10
// Reviews + Ratings + Badges + Trust Score
// =========================================

enum ReviewStatus {
  PENDING
  PUBLISHED
  REPORTED
  REMOVED
}

enum VendorBadge {
  NEW_VENDOR
  VERIFIED
  TOP_RATED
  SUPER_VENDOR
  PREMIUM_PARTNER
  FAST_RESPONSE
}

enum DriverBadge {
  NEW_DRIVER
  VERIFIED
  TOP_DRIVER
  SAFE_DRIVER
  CUSTOMER_FAVOURITE
  PROFESSIONAL
}

enum VehicleBadge {
  VERIFIED
  TOP_CHOICE
  BEST_VALUE
  PREMIUM
  LUXURY
  MOST_BOOKED
}

model Review {
  id                    String          @id @default(cuid())

  bookingId             String          @unique

  customerId            String

  vendorId              String

  driverId              String

  vehicleId             String

  overallRating         Float

  vehicleRating         Float?

  driverRating          Float?

  vendorRating          Float?

  cleanlinessRating     Float?

  punctualityRating     Float?

  behaviourRating       Float?

  reviewTitle           String?

  reviewComment         String?

  customerPhoto         String?

  status                ReviewStatus    @default(PUBLISHED)

  isVerifiedTrip        Boolean         @default(true)

  booking               Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  customer              Customer        @relation(fields: [customerId], references: [id])

  vendor                Vendor          @relation(fields: [vendorId], references: [id])

  driver                Driver          @relation(fields: [driverId], references: [id])

  vehicle               Vehicle         @relation(fields: [vehicleId], references: [id])

  createdAt             DateTime        @default(now())

  updatedAt             DateTime        @updatedAt

  @@index([vendorId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([overallRating])
}

model VendorBadgeHistory {
  id                    String          @id @default(cuid())

  vendorId              String

  badge                 VendorBadge

  active                Boolean         @default(true)

  reason                String?

  vendor                Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt             DateTime        @default(now())

  @@index([vendorId])
}

model DriverBadgeHistory {
  id                    String          @id @default(cuid())

  driverId              String

  badge                 DriverBadge

  active                Boolean         @default(true)

  reason                String?

  driver                Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt             DateTime        @default(now())

  @@index([driverId])
}

model VehicleBadgeHistory {
  id                    String          @id @default(cuid())

  vehicleId             String

  badge                 VehicleBadge

  active                Boolean         @default(true)

  reason                String?

  vehicle               Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt             DateTime        @default(now())

  @@index([vehicleId])
}

model TrustScoreHistory {
  id                    String          @id @default(cuid())

  vendorId              String?

  driverId              String?

  vehicleId             String?

  previousScore         Float

  newScore              Float

  reason                String

  calculatedBy          String?

  calculatedAt          DateTime        @default(now())

  vendor                Vendor?         @relation(fields: [vendorId], references: [id])

  driver                Driver?         @relation(fields: [driverId], references: [id])

  vehicle               Vehicle?        @relation(fields: [vehicleId], references: [id])

  @@index([vendorId])
  @@index([driverId])
  @@index([vehicleId])
}// =========================================
// RIDEGRID DATABASE
// BATCH 11
// Notifications + Live Alerts + Email + SMS +
// WhatsApp + Push Notification System
// =========================================

enum NotificationType {
  BOOKING
  PAYMENT
  TRIP
  DRIVER
  VEHICLE
  VENDOR
  PROMOTION
  SYSTEM
  SECURITY
}

enum NotificationChannel {
  APP
  PUSH
  SMS
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model Notification {
  id                 String                @id @default(cuid())

  userId             String?

  bookingId          String?

  title              String

  message            String

  type               NotificationType

  channel            NotificationChannel

  priority           PriorityLevel         @default(NORMAL)

  status             NotificationStatus    @default(PENDING)

  actionUrl          String?

  imageUrl           String?

  isRead             Boolean               @default(false)

  readAt             DateTime?

  scheduledAt        DateTime?

  sentAt             DateTime?

  user               User?                 @relation(fields: [userId], references: [id])

  booking            Booking?              @relation(fields: [bookingId], references: [id])

  createdAt          DateTime              @default(now())

  updatedAt          DateTime              @updatedAt

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([type])
}

model NotificationTemplate {
  id                 String                @id @default(cuid())

  name               String                @unique

  type               NotificationType

  channel            NotificationChannel

  subject            String?

  title              String

  message            String

  variables          Json?

  active             Boolean               @default(true)

  createdAt          DateTime              @default(now())

  updatedAt          DateTime              @updatedAt
}

model NotificationLog {
  id                 String                @id @default(cuid())

  notificationId     String

  recipient          String

  channel            NotificationChannel

  provider           String?

  providerMessageId  String?

  status             NotificationStatus

  errorMessage       String?

  deliveredAt        DateTime?

  notification       Notification          @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  createdAt          DateTime              @default(now())

  @@index([notificationId])
  @@index([status])
}

model DeviceToken {
  id                 String       @id @default(cuid())

  userId             String

  deviceId           String

  platform           String

  token              String       @unique

  appVersion         String?

  active             Boolean      @default(true)

  lastUsedAt         DateTime?

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt          DateTime     @default(now())

  updatedAt          DateTime     @updatedAt

  @@index([userId])
  @@index([platform])
}

model OTPVerification {
  id                 String      @id @default(cuid())

  userId             String?

  mobile             String?

  email              String?

  otp                String

  purpose            String

  verified           Boolean     @default(false)

  expiresAt          DateTime

  verifiedAt         DateTime?

  attempts           Int         @default(0)

  user               User?       @relation(fields: [userId], references: [id])

  createdAt          DateTime    @default(now())

  @@index([mobile])
  @@index([email])
  @@index([purpose])
}// =========================================
// RIDEGRID DATABASE
// BATCH 12
// Support + Disputes + Complaints +
// Lost & Found + Emergency SOS
// =========================================

enum SupportCategory {
  BOOKING
  PAYMENT
  VENDOR
  DRIVER
  VEHICLE
  ACCOUNT
  TECHNICAL
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum ComplaintAgainst {
  DRIVER
  VENDOR
  VEHICLE
  CUSTOMER
  RIDEGRID
}

enum SOSStatus {
  ACTIVE
  RESPONDED
  CLOSED
}

model SupportTicket {
  id                 String           @id @default(cuid())

  ticketNumber       String           @unique

  userId             String

  bookingId          String?

  category           SupportCategory

  priority           TicketPriority   @default(MEDIUM)

  subject            String

  description        String

  status             TicketStatus     @default(OPEN)

  assignedTo         String?

  resolution         String?

  resolvedAt         DateTime?

  user               User             @relation(fields: [userId], references: [id])

  booking            Booking?         @relation(fields: [bookingId], references: [id])

  messages           TicketMessage[]

  createdAt          DateTime         @default(now())

  updatedAt          DateTime         @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([priority])
}

model TicketMessage {
  id                 String           @id @default(cuid())

  ticketId           String

  senderId           String

  message            String

  attachmentUrl      String?

  internalNote       Boolean          @default(false)

  ticket             SupportTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  sender             User             @relation(fields: [senderId], references: [id])

  createdAt          DateTime         @default(now())

  @@index([ticketId])
}

model Complaint {
  id                 String              @id @default(cuid())

  bookingId          String?

  customerId         String

  against            ComplaintAgainst

  referenceId        String

  title              String

  description        String

  resolved           Boolean             @default(false)

  resolvedAt         DateTime?

  booking            Booking?            @relation(fields: [bookingId], references: [id])

  customer           Customer            @relation(fields: [customerId], references: [id])

  createdAt          DateTime            @default(now())

  @@index([customerId])
  @@index([against])
}

model LostAndFound {
  id                 String          @id @default(cuid())

  bookingId          String

  reportedBy         String

  itemName           String

  description        String?

  found              Boolean         @default(false)

  returned           Boolean         @default(false)

  returnDate         DateTime?

  booking            Booking         @relation(fields: [bookingId], references: [id])

  reporter           User            @relation(fields: [reportedBy], references: [id])

  createdAt          DateTime        @default(now())

  @@index([bookingId])
}

model EmergencySOS {
  id                 String          @id @default(cuid())

  tripId             String

  userId             String

  latitude           Float

  longitude          Float

  status             SOSStatus       @default(ACTIVE)

  responseNotes      String?

  closedAt           DateTime?

  trip               Trip            @relation(fields: [tripId], references: [id])

  user               User            @relation(fields: [userId], references: [id])

  createdAt          DateTime        @default(now())

  @@index([tripId])
  @@index([status])
}// =========================================
// RIDEGRID DATABASE
// BATCH 13
// Corporate Module + Employees +
// Cost Centers + Approval Workflow
// =========================================

enum CorporateStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum EmployeeRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Corporate {
  id                    String              @id @default(cuid())

  companyName           String
  gstNumber             String?             @unique
  panNumber             String?

  contactPerson         String

  email                 String              @unique
  mobile                String

  address               String

  city                  String
  state                 String

  creditLimit           Decimal             @default(0)

  availableCredit       Decimal             @default(0)

  monthlyBilling        Boolean             @default(true)

  status                CorporateStatus     @default(PENDING)

  employees             CorporateEmployee[]
  bookings              Booking[]
  approvals             CorporateApproval[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyName])
  @@index([status])
}

model CorporateEmployee {
  id                    String            @id @default(cuid())

  corporateId           String

  userId                String            @unique

  employeeCode          String?

  department            String?

  designation           String?

  role                  EmployeeRole      @default(EMPLOYEE)

  canBook               Boolean           @default(true)

  bookingLimit          Decimal?

  corporate             Corporate         @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  user                  User              @relation(fields: [userId], references: [id])

  approvals             CorporateApproval[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([corporateId])
}

model CostCenter {
  id                    String            @id @default(cuid())

  corporateId           String

  code                  String

  name                  String

  budget                Decimal?

  active                Boolean           @default(true)

  corporate             Corporate         @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  createdAt             DateTime          @default(now())

  @@unique([corporateId, code])
}

model CorporateApproval {
  id                    String             @id @default(cuid())

  bookingId             String

  corporateId           String

  employeeId            String

  approverId            String?

  status                ApprovalStatus     @default(PENDING)

  remarks               String?

  approvedAt            DateTime?

  booking               Booking            @relation(fields: [bookingId], references: [id])

  corporate            Corporate           @relation(fields: [corporateId], references: [id])

  employee             CorporateEmployee   @relation(fields: [employeeId], references: [id])

  createdAt            DateTime            @default(now())

  @@index([corporateId])
  @@index([status])
}// =========================================
// RIDEGRID DATABASE
// BATCH 14
// Audit Logs + Admin Activity +
// Platform Settings + System Configuration
// =========================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  ASSIGN
  CANCEL
  EXPORT
}

enum AuditEntity {
  USER
  VENDOR
  DRIVER
  VEHICLE
  BOOKING
  PAYMENT
  SETTLEMENT
  CORPORATE
  SYSTEM
}

model AuditLog {
  id                 String        @id @default(cuid())

  userId             String?

  action             AuditAction

  entity             AuditEntity

  entityId           String?

  oldData            Json?

  newData            Json?

  ipAddress          String?

  device             String?

  browser            String?

  os                 String?

  remarks            String?

  user               User?         @relation(fields: [userId], references: [id])

  createdAt          DateTime      @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model AdminActivity {
  id                 String      @id @default(cuid())

  adminId            String

  module             String

  activity           String

  referenceId        String?

  ipAddress          String?

  device             String?

  browser            String?

  admin              User        @relation(fields: [adminId], references: [id])

  createdAt          DateTime    @default(now())

  @@index([adminId])
  @@index([module])
}

model SystemSetting {
  id                 String      @id @default(cuid())

  settingKey         String      @unique

  settingValue       String

  description        String?

  editable           Boolean     @default(true)

  createdAt          DateTime    @default(now())

  updatedAt          DateTime    @updatedAt
}

model PlatformConfiguration {
  id                         String      @id @default(cuid())

  platformName               String      @default("RideGrid")

  platformCommission         Decimal     @default(12)

  gstPercentage              Decimal     @default(5)

  cancellationCharge         Decimal     @default(0)

  vendorSecurityDeposit      Decimal     @default(0)

  autoSettlement             Boolean     @default(false)

  smartReturnEnabled         Boolean     @default(true)

  liveTrackingEnabled        Boolean     @default(true)

  otpVerificationEnabled     Boolean     @default(true)

  reviewSystemEnabled        Boolean     @default(true)

  maintenanceMode            Boolean     @default(false)

  supportEmail               String?

  supportMobile              String?

  updatedBy                  String?

  createdAt                  DateTime    @default(now())

  updatedAt                  DateTime    @updatedAt
}

model PlatformAnnouncement {
  id                 String      @id @default(cuid())

  title              String

  message            String

  targetAudience     String      // ALL, CUSTOMER, VENDOR, DRIVER, CORPORATE

  active             Boolean     @default(true)

  startDate          DateTime?

  endDate            DateTime?

  createdBy          String?

  createdAt          DateTime    @default(now())

  updatedAt          DateTime    @updatedAt

  @@index([active])
  @@index([targetAudience])
}// =========================================
// RIDEGRID DATABASE
// BATCH 15 (FINAL)
// Production Optimization + Smart Search +
// Dynamic Pricing + Promo Engine +
// Route Cache + Final Validation
// =========================================

enum PromoType {
  FLAT
  PERCENTAGE
}

enum PromoStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

model RouteMaster {
  id                    String      @id @default(cuid())

  fromCity              String
  toCity                String

  distanceKm            Float
  estimatedDurationMin  Int

  tollAmount            Decimal     @default(0)

  active                Boolean     @default(true)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([fromCity, toCity])
  @@index([fromCity])
  @@index([toCity])
}

model DynamicPricingRule {
  id                    String      @id @default(cuid())

  name                  String

  bookingType           BookingType?

  vehicleCategory       VehicleCategory?

  city                  String?

  multiplier            Float        @default(1)

  priority              Int          @default(1)

  active                Boolean      @default(true)

  startTime             String?

  endTime               String?

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([active])
}

model PromoCode {
  id                    String        @id @default(cuid())

  code                  String        @unique

  title                 String

  promoType             PromoType

  value                 Decimal

  minimumBookingAmount  Decimal?

  maximumDiscount       Decimal?

  usageLimit            Int?

  usedCount             Int           @default(0)

  validFrom             DateTime

  validTill             DateTime

  status                PromoStatus   @default(ACTIVE)

  createdAt             DateTime      @default(now())

  @@index([code])
}

model SavedRoute {
  id                    String      @id @default(cuid())

  customerId            String

  fromCity              String

  toCity                String

  pickupAddress         String?

  dropAddress           String?

  customer              Customer     @relation(fields: [customerId], references: [id])

  createdAt             DateTime     @default(now())

  @@index([customerId])
}

model SearchHistory {
  id                    String      @id @default(cuid())

  customerId            String?

  fromCity              String

  toCity                String

  vehicleCategory       VehicleCategory?

  searchedAt            DateTime    @default(now())

  customer              Customer?   @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([searchedAt])
}

model FavoriteVehicle {
  id                    String      @id @default(cuid())

  customerId            String

  vehicleId             String

  customer              Customer    @relation(fields: [customerId], references: [id])

  vehicle               Vehicle     @relation(fields: [vehicleId], references: [id])

  createdAt             DateTime    @default(now())

  @@unique([customerId, vehicleId])
}

model PlatformMetric {
  id                    String      @id @default(cuid())

  metricName            String      @unique

  metricValue           Decimal

  lastCalculatedAt      DateTime

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

