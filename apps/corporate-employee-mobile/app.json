{
  "expo": {
    "name": "RideGrid Corporate",
    "slug": "ridegrid-corporate-employee",
    "scheme": "ridegrid-corporate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ridegrid.corporate",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ridegrid.corporate",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95616c8f-4075-4225-83b2-5c33cd96f7dc"
      }
    },
    "owner": "ridegrid_wellcabs"
  }
}
