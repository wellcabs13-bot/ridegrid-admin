{
  "expo": {
    "name": "RideGrid",
    "slug": "ridegrid-customer",
    "version": "1.0.0",
    "scheme": "ridegrid",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ridegrid.customer",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ridegrid.customer"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    }
  }
}
