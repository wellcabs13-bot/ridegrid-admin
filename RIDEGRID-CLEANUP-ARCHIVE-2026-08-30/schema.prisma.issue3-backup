  driverId        String?
  vendorId        String?
  corporateId     String?
  bookingId       String?
  assignedToId    String?
  category        TicketCategory
  priority        TicketPriority
  source          TicketSource
  status          TicketStatus
  subject         String
  description     String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  assignedTo      User?              @relation("AssignedSupportAgent", fields: [assignedToId], references: [id])
