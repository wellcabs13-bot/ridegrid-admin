generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  mobile              String?              @unique
  password            String
  role                UserRole             @default(CUSTOMER)
  isActive            Boolean              @default(true)
  isVerified          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  apiKeys             APIKey[]
  auditLogs           AuditLog[]
  crmActivities       CRMActivity[]        @relation("ActivityOwner")
  crmTasks            CRMTask[]            @relation("TaskOwner")
  corporateEmployee   CorporateEmployee?
  customer            Customer?
  driver              Driver?
  assignedLeads       Lead[]               @relation("LeadOwner")
  loginHistory        LoginHistory[]
  notifications       Notification[]
  securityEvents      SecurityEvent[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  assignedTickets     SupportTicket[]      @relation("AssignedSupportAgent")
  ticketMessages      TicketMessage[]      @relation("SupportMessageSender")
  vendor              Vendor?
}

model Customer {
  id               String             @id @default(cuid())
  userId           String             @unique
  firstName        String
  lastName         String
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  recommendations  AIRecommendation[]
  bookings         Booking[]
  analytics        BookingAnalytics[]
  couponUsages     CouponUsage[]
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  loyaltyAccount   LoyaltyAccount?
  invoices         Invoice[]
  referralPrograms ReferralProgram[]
  reviews          Review[]
  supportTickets   SupportTicket[]
}

model Vendor {
  id                 String              @id @default(cuid())
  userId             String              @unique
  companyName        String
  isApproved         Boolean             @default(false)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bookings           Booking[]
  pricingRules       PricingRule[]
  revenueReports     RevenueSummary[]
  reviews            Review[]
  supportTickets     SupportTicket[]
  transactions       Transaction[]
  invoices           Invoice[]
  vehicles           Vehicle[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics          VendorAnalytics[]
  documents          VendorDocument[]
  performanceReports VendorPerformance[]
  promotions         VendorPromotion[]
  settlements        VendorSettlement[]
  wallet             VendorWallet?
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Driver {
  id                 String              @id @default(cuid())
  userId             String              @unique
  firstName          String
  lastName           String
  licenseNumber      String              @unique
  status             DriverStatus        @default(ACTIVE)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bookings           Booking[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics          DriverAnalytics[]
  attendance         DriverAttendance[]
  documents          DriverDocument[]
  incentives         DriverIncentive[]
  leaveRequests      DriverLeave[]
  payrolls           DriverPayroll[]
  penalties          DriverPenalty[]
  performanceReports DriverPerformance[]
  shifts             DriverShift[]
  reviews            Review[]
  sosEvents          SOSEvent[]
  supportTickets     SupportTicket[]
  trips              Trip[]
  tripLocations      TripLocation[]
  vehicles           Vehicle[]

  @@index([userId])
  @@index([licenseNumber])
  @@index([createdAt])
  @@index([firstName, lastName])
}

model Vehicle {
  id                 String               @id @default(cuid())
  vendorId           String
  driverId           String?
  registrationNumber String               @unique
  make               String
  model              String
  variant            String?
  year               Int?
  color              String?
  category           VehicleCategory
  fuelType           FuelType
  transmission       TransmissionType
  seatingCapacity    Int
  luggageCapacity    Int?
  homeCity           String
  status             VehicleStatus        @default(AVAILABLE)
  baseFare           Decimal              @db.Decimal(10, 2)
  pricePerKm         Decimal?             @db.Decimal(10, 2)
  waitingCharge      Decimal?             @db.Decimal(10, 2)
  nightCharge        Decimal?             @db.Decimal(10, 2)
  rating             Float                @default(0)
  totalTrips         Int                  @default(0)
  isVerified         Boolean              @default(false)
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  bookings           Booking[]
  fuelLogs           FuelLog[]
  gpsDevice          GPSDevice?
  geofenceEvents     GeofenceEvent[]
  dometerLogs        OdometerLog[]
  reviews            Review[]
  routeDeviations    RouteDeviation[]
  sosEvents          SOSEvent[]
  serviceSchedules   ServiceSchedule[]
  trips              Trip[]
  tripLocations      TripLocation[]
  driver             Driver?              @relation(fields: [driverId], references: [id])
  vendor             Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  analytics          VehicleAnalytics[]
  breakdowns         VehicleBreakdown[]
  documents          VehicleDocument[]
  maintenanceRecords VehicleMaintenance[]
  performanceReports VehiclePerformance[]
  PricingPackage     PricingPackage[]

  @@index([vendorId])
  @@index([driverId])
  @@index([status])
  @@index([category])
  @@index([homeCity])
  @@index([isVerified])
  @@index([createdAt])
  @@index([vendorId, status])
  @@index([category, status])
  @@index([homeCity, category])
}

model Booking {
  id                 String                 @id @default(cuid())
  bookingNumber      String                 @unique @default(uuid())
  customerId         String
  vendorId           String
  vehicleId          String
  driverId           String?
  pickupLocation     String
  dropLocation       String
  pickupDateTime     DateTime
  status             BookingStatus          @default(PENDING)
  estimatedFare      Decimal                @db.Decimal(10, 2)
  baseFare           Decimal?               @db.Decimal(10, 2)
  taxAmount          Decimal?               @db.Decimal(10, 2)
  discountAmount     Decimal?               @db.Decimal(10, 2)
  couponAmount       Decimal?               @db.Decimal(10, 2)
  extraCharges       Decimal?               @db.Decimal(10, 2)
  finalFare          Decimal?               @db.Decimal(10, 2)
  vendorEarning      Decimal?               @db.Decimal(10, 2)
  platformCommission Decimal?               @db.Decimal(10, 2)
  driverPayout       Decimal?               @db.Decimal(10, 2)
  cancelledBy        String?
  cancelReason       String?
  cancelledAt        DateTime?
  cancellationCharge Decimal?               @db.Decimal(10, 2)
  refundAmount       Decimal?               @db.Decimal(10, 2)
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  customer           Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driver             Driver?                @relation(fields: [driverId], references: [id])
  vehicle            Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vendor             Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  analytics          BookingAnalytics[]
  statusHistory      BookingStatusHistory[]
  couponUsages       CouponUsage[]
  fraudChecks        FraudDetection[]
  reviews            Review[]
  supportTickets     SupportTicket[]
  transactions       Transaction[]
  invoice            Invoice?
  trip               Trip?

  @@index([customerId])
  @@index([vendorId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  @@index([pickupDateTime])
  @@index([createdAt])
  @@index([customerId, status])
  @@index([vendorId, status])
  @@index([driverId, status])
  @@index([pickupDateTime, status])
  @@index([customerId, pickupDateTime])
  @@index([vendorId, pickupDateTime])
}

model BookingStatusHistory {
  id             String              @id @default(cuid())
  bookingId      String
  previousStatus BookingStatus?
  currentStatus  BookingStatus
  action         BookingStatusAction
  changedBy      String?
  remarks        String?
  changedAt      DateTime            @default(now())
  createdAt      DateTime            @default(now())
  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([currentStatus])
  @@index([changedAt])
}

model Trip {
  id                 String            @id @default(cuid())
  bookingId          String            @unique
  driverId           String
  vehicleId          String
  status             TripStatus        @default(ASSIGNED)
  driverAssignedAt   DateTime?
  driverAcceptedAt   DateTime?
  arrivedPickupAt    DateTime?
  passengerBoardedAt DateTime?
  tripStartedAt      DateTime?
  tripCompletedAt    DateTime?
  cancelledAt        DateTime?
  startTime          DateTime?
  endTime            DateTime?
  startKm            Int?
  endKm              Int?
  totalDistance      Decimal?          @db.Decimal(10, 2)
  totalDuration      Int?
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  damageReports      DamageReport[]
  etaPredictions     ETAPrediction[]
  extraCharges       ExtraCharge[]
  geofenceEvents     GeofenceEvent[]
  rentalExtensions   RentalExtension[]
  returnApprovals    ReturnApproval[]
  routeDeviations    RouteDeviation[]
  sosevents          SOSEvent[]
  booking            Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver             Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle            Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripCheckpoints    TripCheckpoint[]
  tripExpenses       TripExpense[]
  tripLocations      TripLocation[]
}

model VehicleDocument {
  id             String         @id @default(cuid())
  vehicleId      String
  documentType   DocumentType
  documentNumber String?
  fileUrl        String
  issueDate      DateTime?
  expiryDate     DateTime?
  status         DocumentStatus @default(PENDING)
  remarks        String?
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model DriverDocument {
  id             String         @id @default(cuid())
  driverId       String
  documentType   DocumentType
  documentNumber String?
  fileUrl        String
  issueDate      DateTime?
  expiryDate     DateTime?
  status         DocumentStatus @default(PENDING)
  remarks        String?
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  driver         Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model VendorDocument {
  id             String         @id @default(cuid())
  vendorId       String
  documentType   DocumentType
  documentNumber String?
  fileUrl        String
  issueDate      DateTime?
  expiryDate     DateTime?
  status         DocumentStatus @default(PENDING)
  remarks        String?
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vendor         Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model PricingRule {
  id                  String               @id @default(cuid())
  vendorId            String
  vehicleCategory     VehicleCategory
  pricingType         PricingType
  tripType            TripType
  chargeType          ChargeType
  baseFare            Decimal              @db.Decimal(10, 2)
  minimumKm           Int?
  includedKm          Int?
  pricePerKm          Decimal?             @db.Decimal(10, 2)
  pricePerHour        Decimal?             @db.Decimal(10, 2)
  driverAllowance     Decimal?             @db.Decimal(10, 2)
  nightCharge         Decimal?             @db.Decimal(10, 2)
  waitingCharge       Decimal?             @db.Decimal(10, 2)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  dynamicPricingRules DynamicPricingRule[]
  vendor              Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  PricingPackage      PricingPackage[]

  @@unique([vendorId, vehicleCategory, pricingType, tripType])
  @@index([vendorId])
  @@index([vehicleCategory])
  @@index([pricingType])
  @@index([tripType])
  @@index([isActive])
  @@index([vendorId, isActive])
  @@index([vehicleCategory, pricingType])
}

model Transaction {
  id                   String          @id @default(cuid())
  bookingId            String?
  vendorId             String?
  transactionType      TransactionType
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus   @default(PENDING)
  amount               Decimal         @db.Decimal(10, 2)
  currency             String          @default("INR")
  referenceNumber      String?
  gatewayName          String?
  gatewayTransactionId String?
  gatewayFee           Decimal?        @db.Decimal(10, 2)
  taxAmount            Decimal?        @db.Decimal(10, 2)
  gatewayResponse      Json?
  remarks              String?
  processedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  booking              Booking?        @relation(fields: [bookingId], references: [id])
  vendor               Vendor?         @relation(fields: [vendorId], references: [id])

  @@index([bookingId])
  @@index([vendorId])
  @@index([paymentStatus])
  @@index([transactionType])
  @@index([paymentMethod])
  @@index([processedAt])
  @@index([createdAt])
  @@index([vendorId, paymentStatus])
  @@index([bookingId, paymentStatus])
}

model VendorWallet {
  id           String              @id @default(cuid())
  vendorId     String              @unique
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  settlements  VendorSettlement[]
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([vendorId])
}

model WalletTransaction {
  id              String                @id @default(cuid())
  walletId        String
  transactionType WalletTransactionType
  amount          Decimal               @db.Decimal(12, 2)
  balanceBefore   Decimal?              @db.Decimal(12, 2)
  balanceAfter    Decimal?              @db.Decimal(12, 2)
  referenceId     String?
  referenceType   String?
  performedBy     String?
  description     String?
  createdAt       DateTime              @default(now())
  wallet          VendorWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([referenceId])
  @@index([walletId, createdAt])
}

model VendorSettlement {
  id                  String           @id @default(cuid())
  vendorId            String
  walletId            String
  amount              Decimal          @db.Decimal(12, 2)
  commission          Decimal          @default(0) @db.Decimal(12, 2)
  netAmount           Decimal          @db.Decimal(12, 2)
  settlementStatus    SettlementStatus @default(PENDING)
  settlementReference String?
  bankReference       String?
  processedBy         String?
  failureReason       String?
  remarks             String?
  settledAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  vendor              Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  wallet              VendorWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([walletId])
  @@index([settlementStatus])
  @@index([createdAt])
  @@index([settledAt])
  @@index([vendorId, settlementStatus])
}

model Notification {
  id               String             @id @default(cuid())
  userId           String
  notificationType NotificationType
  title            String
  message          String
  status           NotificationStatus @default(PENDING)
  sentAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String           @id @default(cuid())
  bookingId  String
  customerId String
  targetType ReviewTargetType
  driverId   String?
  vehicleId  String?
  vendorId   String?
  rating     Int
  review     String?
  status     ReviewStatus     @default(PUBLISHED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driver     Driver?          @relation(fields: [driverId], references: [id])
  vehicle    Vehicle?         @relation(fields: [vehicleId], references: [id])
  vendor     Vendor?          @relation(fields: [vendorId], references: [id])
}

model Corporate {
  id                   String                     @id @default(cuid())
  companyName          String
  legalName            String?
  gstNumber            String?                    @unique
  panNumber            String?
  email                String                     @unique
  mobile               String
  website              String?
  address              String
  city                 String?
  state                String
  country              String                     @default("India")
  pincode              String
  status               CorporateStatus            @default(ACTIVE)
  billingCycle         CorporateBillingCycle      @default(MONTHLY)
  approvalFlow         ApprovalFlow               @default(MANAGER)
  creditLimit          Decimal?                   @db.Decimal(12, 2)
  paymentTermsDays     Int?                       @default(30)
  accountManagerName   String?
  accountManagerEmail  String?
  accountManagerMobile String?
  deletedAt            DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  approvalRules        CorporateApprovalRule[]
  branches             CorporateBranch[]
  contracts            CorporateContract[]
  costCenters          CorporateCostCenter[]
  corporateDepartments CorporateDepartment[]
  discounts            CorporateDiscount[]
  employees            CorporateEmployee[]
  invoiceSetting       CorporateInvoiceSetting?
  reports              CorporateReport[]
  travelPolicies       CorporateTravelPolicy[]
  wallet               CorporateWallet?
  leads                Lead[]
  supportTickets       SupportTicket[]
  approvalRequests     CorporateApprovalRequest[]
  budgets              CorporateBudget[]
}

model CorporateBranch {
  id           String                @id @default(cuid())
  corporateId  String
  branchName   String
  branchCode   String?
  address      String
  city         String?
  state        String
  pincode      String
  latitude     Decimal?              @db.Decimal(10, 7)
  longitude    Decimal?              @db.Decimal(10, 7)
  isHeadOffice Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  corporate    Corporate             @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  departments  CorporateDepartment[]
  employees    CorporateEmployee[]
}

model CorporateDepartment {
  id             String              @id @default(cuid())
  corporateId    String
  branchId       String?
  departmentName String
  departmentCode String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  branch         CorporateBranch?    @relation(fields: [branchId], references: [id])
  corporate      Corporate           @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  employees      CorporateEmployee[]
}

model CorporateCostCenter {
  id          String              @id @default(cuid())
  corporateId String
  code        String
  name        String
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  corporate   Corporate           @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  employees   CorporateEmployee[]
}

model CorporateEmployee {
  id                     String                     @id @default(cuid())
  corporateId            String
  branchId               String?
  departmentId           String?
  costCenterId           String?
  userId                 String?                    @unique
  employeeCode           String                     @unique
  employeeName           String
  officialEmail          String                     @unique
  mobile                 String
  designation            String
  managerName            String?
  managerEmail           String?
  employeeGrade          String?
  isApprover             Boolean                    @default(false)
  monthlyTravelLimit     Decimal?                   @db.Decimal(12, 2)
  yearlyTravelLimit      Decimal?                   @db.Decimal(12, 2)
  defaultPickupAddress   String?
  emergencyContactName   String?
  emergencyContactMobile String?
  isActive               Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  branch                 CorporateBranch?           @relation(fields: [branchId], references: [id])
  corporate              Corporate                  @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  costCenter             CorporateCostCenter?       @relation(fields: [costCenterId], references: [id])
  department             CorporateDepartment?       @relation(fields: [departmentId], references: [id])
  user                   User?                      @relation(fields: [userId], references: [id])
  approvalRequests       CorporateApprovalRequest[]
}

model CorporateTravelPolicy {
  id                   String    @id @default(cuid())
  corporateId          String
  policyName           String
  maxTripAmount        Decimal?  @db.Decimal(12, 2)
  allowedCategories    Json?
  advanceBookingHours  Int?
  nightTravelAllowed   Boolean   @default(true)
  airportTravelAllowed Boolean   @default(true)
  outstationAllowed    Boolean   @default(true)
  approvalRequired     Boolean   @default(true)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  corporate            Corporate @relation(fields: [corporateId], references: [id], onDelete: Cascade)
}

model CorporateWallet {
  id          String    @id @default(cuid())
  corporateId String    @unique
  balance     Decimal   @default(0) @db.Decimal(12, 2)
  creditLimit Decimal?  @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  corporate   Corporate @relation(fields: [corporateId], references: [id], onDelete: Cascade)
}

model CorporateApprovalRule {
  id                  String    @id @default(cuid())
  corporateId         String
  level               Int
  approverDesignation String
  maxAmount           Decimal?  @db.Decimal(12, 2)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  corporate           Corporate @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  @@unique([corporateId, level])
  @@index([corporateId])
  @@index([level])
}

model CorporateContract {
  id               String    @id @default(cuid())
  corporateId      String
  contractNumber   String    @unique
  startDate        DateTime
  endDate          DateTime
  agreedCommission Decimal?  @db.Decimal(5, 2)
  agreedDiscount   Decimal?  @db.Decimal(5, 2)
  isActive         Boolean   @default(true)
  contractValue    Decimal?  @db.Decimal(14, 2)
  signedBy         String?
  documentUrl      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  corporate        Corporate @relation(fields: [corporateId], references: [id], onDelete: Cascade)
}

model CorporateInvoiceSetting {
  id                  String    @id @default(cuid())
  corporateId         String    @unique
  autoGenerateInvoice Boolean   @default(true)
  invoiceEmail        String?
  sendReminder        Boolean   @default(true)
  reminderDays        Int       @default(7)
  invoicePrefix       String?   @default("RG")
  gstEnabled          Boolean   @default(true)
  billingEmailCC      String?
  autoEmailInvoice    Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  corporate           Corporate @relation(fields: [corporateId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  title           String
  description     String?
  couponType      CouponType
  couponScope     CouponScope
  status          CouponStatus       @default(DRAFT)
  discountValue   Decimal            @db.Decimal(10, 2)
  minimumBooking  Decimal?           @db.Decimal(10, 2)
  maximumDiscount Decimal?           @db.Decimal(10, 2)
  usageLimit      Int?
  usedCount       Int                @default(0)
  validFrom       DateTime
  validTo         DateTime
  isFirstRideOnly Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  campaigns       CampaignCoupon[]
  usages          CouponUsage[]
  festivalOffers  FestivalCampaign[]
  geoOffers       GeoPromotion[]
  vendorOffers    VendorPromotion[]
}

model LoyaltyAccount {
  id           String               @id @default(cuid())
  customerId   String               @unique
  totalPoints  Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               String                 @id @default(cuid())
  loyaltyAccountId String
  transactionType  LoyaltyTransactionType
  points           Int
  description      String?
  createdAt        DateTime               @default(now())
  loyaltyAccount   LoyaltyAccount         @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
}

model PromotionCampaign {
  id           String           @id @default(cuid())
  campaignName String
  description  String?
  startDate    DateTime
