  allocations CorporateBudgetAllocation[]
  alerts      CorporateBudgetAlert[]

  @@index([corporateId])
  @@index([status])
  @@index([startDate, endDate])
}

model CorporateBudgetAllocation {
  id          String   @id @default(cuid())
  budgetId    String
  amount      Decimal  @db.Decimal(12, 2)
  bookingId   String?
  description String?
  allocatedBy String?
  createdAt   DateTime @default(now())

  budget CorporateBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([bookingId])
  @@index([createdAt])
}

model CorporateBudgetAlert {
  id           String                   @id @default(cuid())
  budgetId     String
  alertType    CorporateBudgetAlertType
  threshold    Decimal?                 @db.Decimal(5, 2)
  message      String
  acknowledged Boolean                  @default(false)
  createdAt    DateTime                 @default(now())

  budget CorporateBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([alertType])
  @@index([createdAt])
}

model FileAsset {
  id           String           @id @default(cuid())
  fileName     String
  originalName String?
  mimeType     String?
  fileSize     Int?
  fileUrl      String
  storageKey   String?
  entityType   String?
  entityId     String?
  uploadedBy   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  documents    DocumentRecord[]

  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@index([createdAt])
}

model DocumentRecord {
  id             String         @id @default(cuid())
  fileId         String
  entityType     String
  entityId       String
  documentType   DocumentType
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  status         DocumentStatus @default(PENDING)
  remarks        String?
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  file           FileAsset      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([documentType])
  @@index([status])
  @@index([expiryDate])
  @@index([fileId])
}
