{
    "name":  "ridegrid-admin",
    "version":  "1.0.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "seed":  "tsx prisma/seed.ts",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:coverage":  "vitest run --coverage",
                    "test:e2e":  "playwright test",
                    "test:all":  "npm run test \u0026\u0026 npm run test:e2e",
                    "postinstall":  "prisma generate",
                    "backup":  "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
                    "backup:verify":  "powershell -ExecutionPolicy Bypass -File scripts/verify-backup.ps1",
                    "restore":  "powershell -ExecutionPolicy Bypass -File scripts/restore-db.ps1"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.16.3",
                         "bcrypt":  "^6.0.0",
                         "bcryptjs":  "^3.0.3",
                         "class-variance-authority":  "^0.7.1",
                         "clsx":  "^2.1.1",
                         "jsonwebtoken":  "^9.0.3",
                         "lucide-react":  "^0.542.0",
                         "next":  "15.5.21",
                         "pg":  "^8.16.3",
                         "prisma":  "^6.16.3",
                         "razorpay":  "^2.9.8",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "recharts":  "^3.10.1",
                         "tailwind-merge":  "^3.6.0"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.62.1",
                            "@testing-library/jest-dom":  "^7.0.0",
                            "@testing-library/react":  "^16.3.2",
                            "@types/bcrypt":  "^6.0.0",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/node":  "^22",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "@vitejs/plugin-react":  "^6.0.5",
                            "autoprefixer":  "^10",
                            "eslint":  "^9.39.5",
                            "eslint-config-next":  "^15.3.3",
                            "jsdom":  "^30.0.1",
                            "playwright":  "^1.62.1",
                            "postcss":  "^8",
                            "tailwindcss":  "^3",
                            "tsx":  "^4.23.1",
                            "typescript":  "^5",
                            "vitest":  "^4.1.10"
                        }
}
